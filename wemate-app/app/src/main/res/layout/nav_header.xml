<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/drawer_header_bg"
    android:gravity="bottom"
    android:orientation="vertical"
    android:padding="20dp"
    android:paddingTop="40dp">

    <!-- User Avatar Circle -->
    <FrameLayout
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_avatar_circle">

        <TextView
            android:id="@+id/drawer_avatar_initial"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="W"
            android:textColor="@color/primary"
            android:textSize="22sp"
            android:textStyle="bold" />
    </FrameLayout>

    <TextView
        android:id="@+id/drawer_user_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="WeMate User"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/drawer_user_email"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="user@wemate.com"
        android:textColor="#D4D4FF"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/drawer_user_validity"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_badge_validity"
        android:paddingHorizontal="10dp"
        android:paddingVertical="3dp"
        android:text="30 Days Remaining"
        android:textColor="#B45309"
        android:textSize="12sp"
        android:textStyle="bold" />

</LinearLayout>
