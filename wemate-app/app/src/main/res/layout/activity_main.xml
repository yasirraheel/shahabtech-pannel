<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <!-- ============================================================ -->
    <!-- MAIN CONTENT AREA (everything except the drawer sidebar)     -->
    <!-- ============================================================ -->
    <RelativeLayout
        android:id="@+id/main_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background">

        <!-- ======================= LOGIN SCREEN ======================= -->
        <ScrollView
            android:id="@+id/layout_login"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="28dp"
                android:paddingTop="60dp"
                android:paddingBottom="40dp">

                <!-- Logo Area -->
                <FrameLayout
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:background="@drawable/bg_avatar_circle">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="W"
                        android:textColor="@color/primary"
                        android:textSize="32sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Welcome Back"
                    android:textColor="@color/text_primary"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Sign in to access your Google Flow accounts"
                    android:textColor="@color/text_secondary"
                    android:textAlignment="center"
                    android:textSize="14sp" />

                <!-- Login Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <!-- Username Field -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Username or Email"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/input_username"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_input"
                        android:hint="Enter username or email"
                        android:inputType="textEmailAddress"
                        android:paddingHorizontal="16dp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_muted"
                        android:textSize="14sp" />

                    <!-- Password Field -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Password"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/input_password"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_input"
                        android:hint="Enter your password"
                        android:inputType="textPassword"
                        android:paddingHorizontal="16dp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_muted"
                        android:textSize="14sp" />

                    <!-- Remember Me Checkbox -->
                    <CheckBox
                        android:id="@+id/checkbox_remember_me"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Remember me"
                        android:checked="true"
                        android:buttonTint="@color/primary"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <!-- Sign In Button -->
                    <Button
                        android:id="@+id/btn_login"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="20dp"
                        android:background="@drawable/bg_button_primary"
                        android:text="Sign In"
                        android:textColor="@color/on_primary"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textAllCaps="false"
                        android:stateListAnimator="@null" />

                    <ProgressBar
                        android:id="@+id/login_progress"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center"
                        android:layout_marginTop="16dp"
                        android:indeterminateTint="@color/primary"
                        android:visibility="gone" />

                </LinearLayout>

                <!-- Footer -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="WeMate • Powered by ShahabTech"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp" />

            </LinearLayout>
        </ScrollView>

        <!-- ======================= DASHBOARD SCREEN ======================= -->
        <LinearLayout
            android:id="@+id/layout_accounts"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Top App Bar / Toolbar -->
            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@color/primary"
                app:title="WeMate"
                app:titleTextColor="@color/on_primary"
                app:navigationIcon="@drawable/ic_home"
                app:navigationIconTint="@color/on_primary" />

            <!-- Content Area between toolbar and bottom nav -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingBottom="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="16dp"
                        android:paddingTop="16dp">

                        <!-- Welcome Header Card -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_card"
                            android:orientation="vertical"
                            android:padding="20dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <!-- User Avatar -->
                                <FrameLayout
                                    android:layout_width="52dp"
                                    android:layout_height="52dp"
                                    android:background="@drawable/bg_avatar_circle">

                                    <TextView
                                        android:id="@+id/txt_user_avatar"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:gravity="center"
                                        android:text="U"
                                        android:textColor="@color/primary"
                                        android:textSize="22sp"
                                        android:textStyle="bold" />
                                </FrameLayout>

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:layout_marginStart="14dp"
                                    android:orientation="vertical">

                                    <TextView
                                        android:id="@+id/txt_user_name"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Welcome!"
                                        android:textColor="@color/text_primary"
                                        android:textSize="18sp"
                                        android:textStyle="bold" />

                                    <!-- Validity Badge -->
                                    <LinearLayout
                                        android:id="@+id/container_validity"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="6dp"
                                        android:background="@drawable/bg_badge_validity"
                                        android:gravity="center_vertical"
                                        android:orientation="horizontal"
                                        android:paddingHorizontal="10dp"
                                        android:paddingVertical="3dp">

                                        <TextView
                                            android:id="@+id/txt_user_validity"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="30 Days Remaining"
                                            android:textColor="#B45309"
                                            android:textSize="12sp"
                                            android:textStyle="bold" />
                                    </LinearLayout>
                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Section Title -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="24dp"
                            android:layout_marginBottom="12dp"
                            android:text="Your Assigned Accounts"
                            android:textColor="@color/text_primary"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <ProgressBar
                            android:id="@+id/accounts_progress"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_gravity="center"
                            android:layout_marginTop="40dp"
                            android:indeterminateTint="@color/primary"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/txt_no_accounts"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="40dp"
                            android:gravity="center"
                            android:text="No assigned accounts found.\nContact your administrator."
                            android:textColor="@color/text_muted"
                            android:textSize="14sp"
                            android:lineSpacingExtra="4dp"
                            android:visibility="gone" />

                        <!-- Dynamic Account Cards Container -->
                        <LinearLayout
                            android:id="@+id/container_account_list"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />

                    </LinearLayout>
                </ScrollView>
            </FrameLayout>

            <!-- Bottom Navigation Bar -->
            <com.google.android.material.bottomnavigation.BottomNavigationView
                android:id="@+id/bottom_nav"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/bottom_nav_bg"
                app:elevation="8dp"
                app:itemIconTint="@color/primary"
                app:itemTextColor="@color/text_secondary"
                app:labelVisibilityMode="labeled"
                app:menu="@menu/bottom_nav_menu" />

        </LinearLayout>

        <!-- ======================= WEBVIEW SCREEN ======================= -->
        <LinearLayout
            android:id="@+id/layout_webview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- WebView Top Bar -->
            <LinearLayout
                android:id="@+id/webview_header_bar"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@color/webview_bar_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="4dp">

                <ImageButton
                    android:id="@+id/btn_switch_account"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Back to accounts"
                    android:src="@drawable/ic_back"
                    app:tint="@color/webview_bar_text"
                    android:padding="10dp" />

                <TextView
                    android:id="@+id/txt_active_account_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="Google Flow"
                    android:textColor="@color/webview_bar_text"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btn_refresh_webview"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Refresh"
                    android:src="@drawable/ic_refresh"
                    app:tint="@color/webview_bar_text"
                    android:padding="10dp" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/webview_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:indeterminate="true"
                android:indeterminateTint="@color/primary"
                android:visibility="gone" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <WebView
                    android:id="@+id/webview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <!-- Custom Flow Fullscreen Loader Overlay -->
                <RelativeLayout
                    android:id="@+id/layout_webview_loader"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#0B0F19"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="24dp">

                        <ProgressBar
                            android:id="@+id/loader_spinner"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:indeterminate="true"
                            android:indeterminateTint="#6366F1" />

                        <TextView
                            android:id="@+id/txt_loader_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp"
                            android:text="Loading Google Flow..."
                            android:textColor="#FFFFFF"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txt_loader_subtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="Connecting to creative studio session..."
                            android:textColor="#94A3B8"
                            android:textSize="13sp" />

                        <ProgressBar
                            android:id="@+id/loader_progress_bar"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="220dp"
                            android:layout_height="6dp"
                            android:layout_marginTop="20dp"
                            android:max="100"
                            android:progress="15"
                            android:progressTint="#6366F1"
                            android:progressBackgroundTint="#1E293B" />

                        <TextView
                            android:id="@+id/txt_loader_percent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="15%"
                            android:textColor="#818CF8"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                    </LinearLayout>
                </RelativeLayout>

                <!-- Floating In-Action Notification Banner -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_action_loader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentTop="true"
                    android:layout_centerHorizontal="true"
                    android:layout_marginTop="16dp"
                    android:visibility="gone"
                    app:cardBackgroundColor="#1E293B"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="6dp"
                    app:strokeColor="#6366F1"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="10dp">

                        <ProgressBar
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:indeterminate="true"
                            android:indeterminateTint="#818CF8" />

                        <TextView
                            android:id="@+id/txt_action_loader_msg"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="Creating new project..."
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </RelativeLayout>

        </LinearLayout>

        <!-- Dedicated Background API WebView for panel communications (Must be attached for Chromium renderer) -->
        <WebView
            android:id="@+id/api_webview"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:alpha="0.01" />

    </RelativeLayout>

    <!-- ============================================================ -->
    <!-- NAVIGATION DRAWER (sidebar)                                  -->
    <!-- ============================================================ -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        app:headerLayout="@layout/nav_header"
        app:menu="@menu/drawer_menu" />

</androidx.drawerlayout.widget.DrawerLayout>